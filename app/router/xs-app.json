{
  "welcomeFile": "/explainer/index.html",
  "authenticationMethod": "route",
  "routes": [
    { "source": "^/odata/(.*)$", "target": "/odata/$1", "destination": "srv-api", "authenticationType": "xsuaa", "csrfProtection": true },
    { "source": "^/explainer/(.*)$", "target": "/explainer/$1", "destination": "srv-api", "authenticationType": "xsuaa" }
  ]
}
